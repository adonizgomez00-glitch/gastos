# Copiar a .env (NO versionar) y ajustar. En produccion: chmod 600 /opt/gastos/.env
NODE_ENV=development

# Servidor
GASTOS_HOST=127.0.0.1
GASTOS_PORT=8100
# Prefijo publico (nginx hace proxy_pass quitando el prefijo; el codigo usa rutas relativas)
GASTOS_BASE_PATH=/gastos
GASTOS_BODY_LIMIT=1048576

# Dominio
GASTOS_BASE_CURRENCY=GTQ
GASTOS_TIMEZONE=America/Guatemala
GASTOS_DATA_DIR=./data

# Sesion
GASTOS_SESSION_COOKIE=gastos_session
GASTOS_SESSION_TTL_MINUTES=720
GASTOS_COOKIE_SECURE=1

# Cotizaciones (la primaria no requiere API key)
GASTOS_RATES_PRIMARY_URL=https://open.er-api.com/v6/latest/USD
GASTOS_RATES_SECONDARY_URL=https://www.banguat.gob.gt/variables/ws/TipoCambio.asmx

# Logs (nunca se registran montos, descripciones, emails ni tokens)
GASTOS_LOG_LEVEL=info
